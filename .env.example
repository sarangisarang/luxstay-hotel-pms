# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=booking
DB_USER=booking_user
DB_PASS=your_strong_password_here          # REQUIRED — change before deploy

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here            # REQUIRED — min 32 chars
JWT_TTL_SECONDS=86400                      # optional — default 24 h

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...             # REQUIRED
STRIPE_PUBLISHABLE_KEY=pk_test_...        # REQUIRED
# https://dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...           # REQUIRED for webhook validation

# ── Email (Gmail example) ─────────────────────────────────────────────────────
# Gmail: enable 2FA → myaccount.google.com/apppasswords → create App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com                  # REQUIRED
MAIL_PASS=your_app_password               # REQUIRED — use App Password, not account password
MAIL_FROM=noreply@yourdomain.com

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# At least one key is needed for AI insights & chat features
GEMINI_API_KEY=                           # https://aistudio.google.com/app/apikey
ANTHROPIC_API_KEY=                        # https://console.anthropic.com/

# ── URLs & CORS ───────────────────────────────────────────────────────────────
APP_SERVER_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
APP_IMAGE_BASE_URL=https://api.yourdomain.com/roomtype/
GROQ_API_KEY=                             # https://console.groq.com/keys