# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=booking
DB_USER=booking_user
DB_PASS=your_strong_password_here          # REQUIRED — change before deploy

# ── Backups (scripts/backup.sh) ───────────────────────────────────────────────
# Must be OUTSIDE this repository: dumps contain guest personal data.
BACKUP_DIR=                                # optional — default ~/luxstay-backups

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here            # REQUIRED — min 32 chars
JWT_TTL_SECONDS=86400                      # optional — default 24 h

# ── Stripe (online card payment on the booking website) ──────────────────────
# Off by default: the website then offers "pay at the hotel" only.
# Switch on only with real keys AND the webhook configured
# (Stripe dashboard → Developers → Webhooks → /api/public/stripe/webhook,
#  events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded).
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_HOLD_MINUTES=30                    # how long a room is held during online payment

# ── Website bookings ─────────────────────────────────────────────────────────
PAY_AT_HOTEL_ENABLED=true                 # book now, pay at the hotel (payment stays PENDING)
BOOKING_MAX_NIGHTS=30                     # longest stay bookable online
BOOKING_MAX_OPEN_PER_EMAIL=3              # open online bookings per email address

# ── Email (Gmail example) ─────────────────────────────────────────────────────
# Gmail: enable 2FA → myaccount.google.com/apppasswords → create App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com                  # REQUIRED
MAIL_PASS=your_app_password               # REQUIRED — use App Password, not account password
MAIL_FROM=noreply@yourdomain.com

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# At least one key is needed for AI insights & chat features
GEMINI_API_KEY=                           # https://aistudio.google.com/app/apikey
ANTHROPIC_API_KEY=                        # https://console.anthropic.com/

# ── URLs & CORS ───────────────────────────────────────────────────────────────
APP_SERVER_URL=https://api.yourdomain.com
# Browser origins allowed to call the API / open the chat WebSocket (comma separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Public website URL, used in e-mailed links ("manage my booking", password reset)
FRONTEND_URL=https://yourdomain.com
APP_IMAGE_BASE_URL=https://api.yourdomain.com/roomtype/
GROQ_API_KEY=                             # https://console.groq.com/keys

# ── Security ─────────────────────────────────────────────────────────────────
# Client IPs (for rate limits) are taken from X-Forwarded-For only when the
# request comes from a trusted proxy. Default: private network ranges. If your
# reverse proxy has a public address, set its address as a regex (leave unset otherwise):
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=203\.0\.113\.7
AUTH_SINGLE_SESSION=false                 # true = a new login ends other sessions
API_DOCS_ENABLED=false                    # Swagger UI / OpenAPI JSON (keep off in production)